# Copy this file to .env for local Toncenter API keys.
# Acton loads .env automatically and uses Toncenter for network access.
# API keys are available from https://t.me/toncenter.
# Uncomment the network keys you need:
# TONCENTER_MAINNET_API_KEY="your-mainnet-key-here"
# TONCENTER_TESTNET_API_KEY="your-testnet-key-here"

# Pothole public deployment configuration (replace with real Ed25519 public keys).
# POTHOLE_OWNER_PUBLIC_KEY=0x...
# POTHOLE_USER_PUBLIC_KEY=0x...
# Direct deployment binds its deployer wallet as the authenticated factory.
# POTHOLE_ID=0 # use a fresh id when deploying another standalone mailbox
# POTHOLE_USER_ADDRESS="user-wallet-address" # direct deployment; defaults to deployer
# POTHOLE_OWNER_ADDRESS="factory-owner-address" # factory deployment; defaults to deployer
# Mailbox expiration: uint32 UNIX seconds; 0 = never. Used by deploy and mint.
# Set once in the initialization message, without changing the predicted address.
# Factory mints require a future timestamp or 0 and allocate a fresh sequential id.
# POTHOLE_EXPIRATION=0
# POTHOLE_ADDRESS="mailbox-address"
# POTHOLE_WALLET="alice"
# Optional factory deployment and mint configuration.
# POTHOLE_FACTORY_ID=0
# POTHOLE_FACTORY_ADDRESS="factory-address"
# POTHOLE_QUERY_ID=0 # uint64 correlation id for initialize, mint and close
# POTHOLE_MINT_VALUE=200000000 # nanoton: 0.2 TON; factory checks current gas prices
# The owner posts seqno 0 to confirm; then user (1), owner (2), etc.
# scripts/close.tolk uses POTHOLE_ADDRESS and POTHOLE_WALLET (stored user only).
# POTHOLE_CIPHERTEXT="nonce-tag-ciphertext-as-hex"
# Alternative arbitrary payload: single-root BoC, encoded as hex or base64.
# Set only one of POTHOLE_PAYLOAD_BOC and POTHOLE_CIPHERTEXT.
# POTHOLE_PAYLOAD_BOC="payload-boc"
# POTHOLE_OUTPUT="boc"
# Export POTHOLE_SHARED_KEY privately in your shell for scripts/cipher.mjs.
# Never put the encryption key in contract state, an external message, or git.
